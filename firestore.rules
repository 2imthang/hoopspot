rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TASK-033: Admin's own `users/{uid}` doc has role == 'admin' — used to
    // gate every Admin-only rule below. Firestore caches repeated get()
    // calls to the same path within one rule evaluation, so this is cheap
    // even for a `list` query that checks it once per matched doc.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // A user can read their own document; Admin can read anyone's (needed
    // to list pending Owners). `create` is always the caller writing their
    // own first doc at registration. `update`: Admin can change anyone
    // (approve/reject Owner, later lock/unlock accounts); a normal user can
    // only perform the one self-service "nộp lại hồ sơ" transition
    // (rejected -> pending, clearing rejectReason) and nothing else — in
    // particular this blocks a user from ever self-granting role or status
    // via a raw client write, which the previous unrestricted self-update
    // rule allowed and which would have made TASK-033's approval gate
    // meaningless.
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && request.resource.data.rejectReason == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectReason']))
      );
      allow delete: if false;
    }

    // Any signed-in user can read courts (Home/Search browse them all).
    // Creating requires the new doc's ownerId to be the caller themself.
    // Deleting is Owner-only. Updating: the Owner who created a court can
    // change any of their own fields; Admin (TASK-034) can ONLY flip
    // `isHidden` on ANY court ("ẩn/hiện sân vi phạm") — not full edit
    // rights, so a compromised/malicious admin session can't rewrite a
    // court's price/location/etc, only hide or unhide it.
    match /courts/{courtId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHidden']))
      );
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // A booking can only be read by the User who made it, the Owner of the
    // court it's for, or Admin (TASK-035 — "Giao dịch" reads every booking
    // read-only, to look up disputes by booking ID/user). Client can only
    // ever CREATE a fresh pendingPayment booking for themself — every later
    // status change (payment confirmed, cancelled, rain-cancelled...) goes
    // through a path added in a later task, not a raw client update, so it
    // can't be forged — this stays `false` even for Admin, on purpose (see
    // functional-spec 4.11's anti-fraud rule, TASK-032's doc comment).
    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.ownerId
          || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pendingPayment';
      allow update, delete: if false;
    }

    // One doc per (courtId, date, timeSlot) — the "unique constraint" the
    // anti-double-booking transaction in TASK-015 reads/writes atomically.
    // Any signed-in user may read/write it: the real protection is that a
    // slotLock alone is useless without a matching `bookings` doc, which is
    // still locked down by the rule above.
    match /slotLocks/{slotId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Written only by the Cloudflare payment worker (TASK-020/021), which
    // authenticates as a Firebase service account via the Admin REST API —
    // that identity bypasses Security Rules entirely, so this block is not
    // what protects the data. It's here to make the intent explicit: the
    // Flutter client never reads/writes `payments` directly (no feature
    // needs it to), everything it needs to show the user is mirrored onto
    // the `bookings` docs it already has real-time access to.
    match /payments/{txnRef} {
      allow read, write: if false;
    }

    // A user's favorited courts (TASK-028) — doc ID == their own uid, only
    // they can ever read/write it.
    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reviews (TASK-029) — doc ID == bookingId, so a 2nd write to the same
    // booking is an `update` (blocked below), not a `create`: this alone
    // enforces "mỗi booking chỉ được đánh giá 1 lần" without a separate
    // flag. Create requires the caller to actually own that booking and it
    // be `confirmed` — blocks reviewing a court never booked/paid for, per
    // functional-spec 4.8's edge case ("chặn ở cả UI lẫn backend"). Anyone
    // signed in can read (Court Detail shows everyone's reviews).
    match /reviews/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'confirmed';
      allow update, delete: if false;
    }
  }
}
