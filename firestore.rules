rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user can only read/create/update their own document (doc ID == their
    // Auth uid). No one can read someone else's profile or edit role/status
    // on their own — that's enforced further once Owner/Admin flows exist.
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Any signed-in user can read courts (Home/Search browse them all).
    // Creating requires the new doc's ownerId to be the caller themself —
    // updating/deleting requires the EXISTING doc's ownerId to match, so
    // only the Owner who created a court can ever change or delete it.
    match /courts/{courtId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // A booking can only be read by the User who made it or the Owner of
    // the court it's for. Client can only ever CREATE a fresh pendingPayment
    // booking for themself — every later status change (payment confirmed,
    // cancelled, rain-cancelled...) goes through a path added in a later
    // task, not a raw client update, so it can't be forged.
    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pendingPayment';
      allow update, delete: if false;
    }

    // One doc per (courtId, date, timeSlot) — the "unique constraint" the
    // anti-double-booking transaction in TASK-015 reads/writes atomically.
    // Any signed-in user may read/write it: the real protection is that a
    // slotLock alone is useless without a matching `bookings` doc, which is
    // still locked down by the rule above.
    match /slotLocks/{slotId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Written only by the Cloudflare payment worker (TASK-020/021), which
    // authenticates as a Firebase service account via the Admin REST API —
    // that identity bypasses Security Rules entirely, so this block is not
    // what protects the data. It's here to make the intent explicit: the
    // Flutter client never reads/writes `payments` directly (no feature
    // needs it to), everything it needs to show the user is mirrored onto
    // the `bookings` docs it already has real-time access to.
    match /payments/{txnRef} {
      allow read, write: if false;
    }

    // A user's favorited courts (TASK-028) — doc ID == their own uid, only
    // they can ever read/write it.
    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reviews (TASK-029) — doc ID == bookingId, so a 2nd write to the same
    // booking is an `update` (blocked below), not a `create`: this alone
    // enforces "mỗi booking chỉ được đánh giá 1 lần" without a separate
    // flag. Create requires the caller to actually own that booking and it
    // be `confirmed` — blocks reviewing a court never booked/paid for, per
    // functional-spec 4.8's edge case ("chặn ở cả UI lẫn backend"). Anyone
    // signed in can read (Court Detail shows everyone's reviews).
    match /reviews/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'confirmed';
      allow update, delete: if false;
    }
  }
}
